local SALT = "BoliviaOn::2026"

local function hash(str)
    local h = 5381
    for i = 1, #str do
        h = (h * 33 + string.byte(str, i) + #SALT) % 4294967296
    end
    return string.format("%08x", h)
end

local function trim(s) return (s:gsub("^%s*(.-)%s*$", "%1")) end

