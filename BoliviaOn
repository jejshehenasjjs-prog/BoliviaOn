local function expired(exp)
    if not exp then return false end
    local y, m, d = string.match(exp, "^(%d+)-(%d+)-(%d+)$")
    if not y then return false end
    local ok, now = pcall(os.time)
    if not ok then return false end
    local ok2, t = pcall(function()
        return os.time({ year = tonumber(y), month = tonumber(m), day = tonumber(d), hour = 23 })
    end)
    if not ok2 then return false end
    return now > t
end

local function loadBinds()
    if not (isfile and readfile) or not isfile("BoliviaOn_binds.json") then return {} end
    local ok, d = pcall(function() return Http:JSONDecode(readfile("BoliviaOn_binds.json")) end)
    return (ok and type(d) == "table") and d or {}
end
local function saveBind(h, id)
    if not writefile then return end
    local b = loadBinds()
    b[h] = id
    pcall(function() writefile("BoliviaOn_binds.json", Http:JSONEncode(b)) end)
end

local function fetchRemote()
    if REMOTE_URL == "" then return end
    local ok, body = pcall(function()
        if syn and syn.request then
            local r = syn.request({ Url = REMOTE_URL, Method = "GET" })
            return r and r.Body
        elseif request then
            local r = request({ Url = REMOTE_URL, Method = "GET" })
            return r and r.Body
        else
            return HttpGet(REMOTE_URL)
        end
    end)
    if not ok or type(body) ~= "string" then return end
    local ok2, data = pcall(function() return Http:JSONDecode(body) end)
    if ok2 and type(data) == "table" then
        for k, v in pairs(data) do
            if KEYS[k] == nil then KEYS[k] = v end
        end
    end
end

